&i2c0 {
    clock-frequency = < I2C_BITRATE_FAST >;

    m24c32: m24c32@50 {
        compatible = "atmel,at24";
        status = "okay";
        reg = < 0x50 >;
        size = < 4096 >;
        pagesize = < 32 >;
        address-width = < 16 >;
        timeout = < 5 >;
        wp-gpios = < &gpio0 29 GPIO_PULL_UP >;
    };

    pcf8563: pcf8563@51 {
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x51 >;
        label = "RTC";
    };

    tca6408a_0: tca6408a@20 {
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x20 >;
        label = "I/O Expander 0";
    };

    tca6408a_1: tca6408a@21 {
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x21 >;
        label = "I/O Expander 1";
    };
};

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SCL, 0, 2)>,
                <NRF_PSEL(TWIM_SDA, 0, 31)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SCL, 0, 2)>,
                <NRF_PSEL(TWIM_SDA, 0, 31)>;
    };
};

&uart0 {
    status = "disabled";
};


&spi1 {
    cs-gpios = < &gpio0 20 GPIO_ACTIVE_LOW >,
               < &gpio0 22 GPIO_ACTIVE_LOW >,
               < &gpio0 24 GPIO_ACTIVE_LOW >;

    ade7753_0: ade7753@0 {
        compatible = "spi-device";
        reg = < 0 >;
        spi-max-frequency = < 10000000 >;
        label = "Energy Meter 0";
    };

    ade7753_1: ade7753@1 {
        compatible = "spi-device";
        reg = < 1 >;
        spi-max-frequency = < 10000000 >;
        label = "Energy Meter 1";
    };

    ade7753_2: ade7753@2 {
        compatible = "spi-device";
        reg = < 2 >;
        spi-max-frequency = < 10000000 >;
        label = "Energy Meter 2";
    };
};

&spi1_default {
    group1 {
        psels = < NRF_PSEL(SPIM_SCK, 0, 13) >,
                < NRF_PSEL(SPIM_MISO, 0, 15) >,
                < NRF_PSEL(SPIM_MOSI, 0, 17) >;
    };
};

&spi1_sleep {
    group1 {
        psels = < NRF_PSEL(SPIM_SCK, 0, 13) >,
                < NRF_PSEL(SPIM_MISO, 0, 15) >,
                < NRF_PSEL(SPIM_MOSI, 0, 17) >;
    };
};

/ {
    aliases {
    eeprom = &m24c32;
    rtc = &pcf8563;
    ioexpander0 = &tca6408a_0;
    ioexpander1 = &tca6408a_1;
    energymeter0 = &ade7753_0;
    energymeter1 = &ade7753_1;
    energymeter2 = &ade7753_2;
    };
};
